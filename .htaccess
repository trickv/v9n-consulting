# Repo-wide protections.
#
# This repository is checked out as-is into the web doc root, so anything
# committed is potentially web-accessible. Block files and patterns that
# should never be served, even if Apache's default config would allow them.

# Block all dotfiles and dotdirectories (.git, .claude, .htaccess, .env, etc.)
RedirectMatch 404 /\..*$

# Block repo-internal scripts that live at the doc root.
<Files "pull">
    Require all denied
</Files>
<Files "webhook.cgi">
    Require all denied
</Files>

# Block markdown docs at the repo root. Scoped by filename so that public
# markdown elsewhere (e.g. apps/baby-monitor/PRIVACY.md) keeps serving.
<Files "CLAUDE.md">
    Require all denied
</Files>
<Files "DEPLOYMENT.md">
    Require all denied
</Files>
<Files "README-website.md">
    Require all denied
</Files>
<Files "SEO-SOCIAL-TAGS-SUMMARY.md">
    Require all denied
</Files>

# Block source/data files that should never be served from the doc root.
# .py covers build_landscape.py and any future stray script.
# .yaml/.yml covers ai_tools_landscape.yaml, .pre-commit-config.yaml, and
# any future config files committed at any depth.
<FilesMatch "\.(py|ya?ml)$">
    Require all denied
</FilesMatch>
